# Copy this file to .env for local testing.
# In production (Vercel), add these same names as Environment Variables instead — never commit real values.

PORT=3000
TZ=Asia/Kolkata
START_DATE=2026-07-05

# Groq (reasoning brain) — console.groq.com -> API Keys
GROQ_API_KEY=your_groq_api_key_here

# Notion (memory) — notion.so/my-integrations -> create an internal integration
NOTION_TOKEN=your_notion_integration_token_here
OPEN_TASKS_PAGE_ID=37caa293-e5a2-8150-9e0f-f69e22a60b2d
EXCUSE_LEDGER_DB=your_excuse_ledger_db_id_here
TASK_LOG_DB=your_task_log_db_id_here
ACTIVE_COMMITMENT_DB=c8adb156-a560-447b-bf9f-036f05abf0ba
PARKED_THREADS_DB=d50e4f60-f97c-4cbd-af1d-208673a2c5c6
COMMITMENT_HISTORY_DB=57a5d84b-3229-43e7-842d-7353768a9dda
ITEM_REGISTRY_DB=8d54f25c-02d2-4a77-a569-089bf86bda29
DAY_SCHEDULE_DB=55873184-08db-4e66-88af-5fd90f02d1f4
GROCERY_LIST_DB=0ad55bcf-47a7-416b-aded-69a43f7d82e1

# Google Calendar (real events) — console.cloud.google.com -> OAuth client (Desktop app)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary
